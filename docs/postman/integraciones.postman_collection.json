        "body": {
          "mode": "raw",
          "raw": "{\"total_centavos\":1}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 200',()=>pm.response.to.have.status(200));",
              "pm.test('Comprobante simulado e importe original',()=>{const d=pm.response.json();pm.expect(d.simulado).eq(true);pm.expect(d.estado).eq('completada');pm.expect(d.total_centavos).eq(101);});",
              "pm.collectionVariables.set('facturacion_ref',pm.response.json().referencia);"
            ]
          }
        }
      ]
    },
