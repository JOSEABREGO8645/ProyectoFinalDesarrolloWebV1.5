    {
      "name": "Login del superusuario",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 200\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) { const u = pm.response.json().usuario; pm.collectionVariables.set(\"admin_id\", u._id); pm.collectionVariables.set(\"sucursal_id\", u.sucursal_id); pm.collectionVariables.set(\"admin_usuario\", u.usuario); }",
              "pm.test(\"Sin refresh en JSON\", function () { pm.expect(pm.response.json()).not.to.have.property(\"refresh_token\"); });",
              "pm.test(\"Cookie HttpOnly\", function () { pm.expect(pm.response.headers.get(\"Set-Cookie\")).to.match(/httponly/i); });",
              "if (pm.response.code === 200) { const cookie = pm.response.headers.get(\"Set-Cookie\").match(/libreria_refresh=([^;]+)/)[1]; pm.collectionVariables.set(\"refresh_original\", decodeURIComponent(cookie)); }",
              "if (pm.response.code === 200) { const data = pm.response.json(); pm.collectionVariables.set(\"access_token\", data.access_token); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
