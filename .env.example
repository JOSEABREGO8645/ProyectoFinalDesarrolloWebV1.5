# Copie los bloques a backend/.env y frontend/.env. NO escriba credenciales reales aquí.

# ---------- backend/.env ----------
APP_NAME="Libreria San Francisco"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mongodb
DB_URI="mongodb://USUARIO:CLAVE@localhost:27018/?authSource=admin"
DB_DATABASE=libreria_san_francisco

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Sesiones JWT (Fase 8)
JWT_SECRET=genere-una-clave-larga-y-aleatoria
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# APIs externas (Fase 13)
FEL_URL=http://127.0.0.1:4000
TIPO_CAMBIO_URL=https://open.er-api.com/v6/latest/USD
GEOCODIFICACION_URL=https://nominatim.openstreetmap.org/search

# ---------- frontend/.env ----------
VITE_API_URL=http://127.0.0.1:8000/api