      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "const r=pm.response.json();const valor=l=>r.resumen.find(x=>x.label===l).valor;pm.test('Total completo con una fila visible',()=>{pm.expect(r.filas.length).to.eql(1);pm.expect(r.paginacion.total).to.be.above(25);pm.expect(valor('Unidades')).to.eql(5);});"
            ]
          }
        }
      ]
    },
