{
  "info": {
    "name": "Reportes: nueve analisis y exportacion",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8002/api"
    },
    {
      "key": "usuario",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/auth/login",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "XMLHttpRequest"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"usuario\": \"{{usuario}}\", \"password\": \"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.collectionVariables.set('access_token',pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Sucursal del perfil",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/auth/me",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "XMLHttpRequest"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.collectionVariables.set('sucursal_id',pm.response.json().sucursal_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Nueve reportes distintos",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/reportes",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "XMLHttpRequest"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('Nueve tipos y titulos distintos',()=>{const r=pm.response.json().reportes;pm.expect(r.length).to.eql(9);pm.expect(new Set(r.map(x=>x.titulo)).size).to.eql(9);});"
            ]
          }
        }
      ]
    },
    {
      "name": "Selector incluye historicos",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/reportes/productos?q=REP-HISTORICO",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "XMLHttpRequest"
          },
          {
