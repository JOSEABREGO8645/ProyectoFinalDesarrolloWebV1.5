              "pm.test('Confirmación persistida y reserva oculta',()=>{const d=pm.response.json();pm.expect(d.integraciones.facturacion.referencia).eq(pm.collectionVariables.get('facturacion_ref'));pm.expect(d).not.have.property('api_en_curso');});"
            ]
