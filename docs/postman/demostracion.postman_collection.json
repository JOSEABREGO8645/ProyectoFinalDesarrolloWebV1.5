            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"usuario\":\"{{usuario_0}}\",\"password\":\"{{password_0}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 200',()=>pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token',pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
