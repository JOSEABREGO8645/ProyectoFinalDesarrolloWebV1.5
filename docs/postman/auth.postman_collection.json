{
  "info": {
    "name": "Librería San Francisco — Sesiones JWT y permisos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Fases 8 y 9. Configurar usuario/password de un superusuario de pruebas y password_empleado (mínimo 10 caracteres). Crea y elimina un empleado ficticio. La reutilización de refresh se prueba solo en la sesión creada por esta colección. Ejecutar en BD aislada."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "usuario",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "password_empleado",
      "value": ""
    }
  ],
