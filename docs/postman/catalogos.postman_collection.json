{
  "info": {
    "name": "Librería San Francisco — Fases 6 y 7",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "CRUD protegido de Proveedores, Clientes y Productos. Configurar usuario/password de un superusuario de pruebas. Crea datos ficticios y elimina al final sus propios registros. Usar una base aislada. Los casos de autenticacion y permisos estan en auth.postman_collection.json."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "usuario",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login administrativo",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "XMLHttpRequest"
          }
        ],
        "url": "{{base_url}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"usuario\": \"{{usuario}}\", \"password\": \"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login correcto\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"access_token\", pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
