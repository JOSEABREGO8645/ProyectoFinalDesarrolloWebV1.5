      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('Producto inactivo disponible para filtrar',()=>{const r=pm.response.json();pm.expect(r.length).to.eql(1);pm.expect(r[0].activo).to.eql(false);});"
            ]
          }
        }
      ]
    },
    {
      "name": "existencias",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/reportes/existencias?sucursal_id={{sucursal_id}}&por_pagina=1",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "XMLHttpRequest"
